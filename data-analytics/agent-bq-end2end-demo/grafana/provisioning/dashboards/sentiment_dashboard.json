      "title": "Real-Time User Sentiment Polarity Trend",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "BigQuery-Vegas-Navigator"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "BigQuery-Vegas-Navigator"
          },
          "editorMode": "code",
          "format": "timeSeries",
          "rawQuery": true,
          "rawSql": "SELECT timestamp as time, CAST(JSON_VALUE(sentiment, '$.score') AS FLOAT64) as sentiment_score, 'User Sentiment' as metric FROM `next_navigator.sentiment_analysis_results` WHERE timestamp >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 1 HOUR) ORDER BY timestamp ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "showPoints": "auto",
            "pointSize": 5,
            "gradientMode": "scheme",
            "fillOpacity": 15
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": -1.0
              },
              {
                "color": "yellow",
                "value": -0.2
              },
              {
                "color": "green",
                "value": 0.2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
