      "type": "barchart",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "BigQuery-Vegas-Navigator"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "BigQuery-Vegas-Navigator"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT JSON_VALUE(entity, '$.name') as entity_name, COUNT(1) as occurrence_count FROM `next_navigator.sentiment_analysis_results`, UNNEST(JSON_QUERY_ARRAY(entities)) AS entity GROUP BY entity_name ORDER BY occurrence_count DESC LIMIT 15"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "entity_name"
      }
    }
