rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Product Catalog: Publicly readable, writeable only by Admin/Server
    match /products/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Shopping Carts: Scoped to the authenticated user's UID
    match /carts/{uid}/items/{id} {
      // 1. Path ownership: Only the authenticated owner can write
      // 2. Strict schema check: Client can only provide 'qty' (no price/discount injection)
      // 3. Type and boundary validation: Integer between 1 and 99
      allow create, update: if request.auth != null 
                             && request.auth.uid == uid
                             && request.resource.data.keys().hasOnly(['qty'])
                             && request.resource.data.qty is int
                             && request.resource.data.qty > 0
                             && request.resource.data.qty <= 99;
                             
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Orders Collection: Immutable and created strictly by Cloud Run backend
    match /orders/{id} {
      // "Rules are not filters": Client queries must filter by where("ownerUid", "==", auth.uid)
      allow get, list: if request.auth != null 
                        && request.auth.uid == resource.data.ownerUid;
                        
      // Client direct order writes are strictly forbidden
      allow write: if false;
    }
  }
}
