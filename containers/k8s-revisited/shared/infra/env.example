# Copy to shared/infra/.env and fill in. The .env file is gitignored.
PROJECT_ID=
REGION=us-central1
ZONE=us-central1-a
CLUSTER_PREFIX=k8s-revisited
# The one Flash-class Gemini model used for every agent check in the series.
PINNED_FLASH_MODEL=gemini-3.8-flash
# Model calls go through your Google Cloud project (Google Gen AI SDK, enterprise backend).
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=${PROJECT_ID}
GOOGLE_CLOUD_LOCATION=global
