# Environment & local configuration
.env
.env.*
!.env.example

# GCP & TLS credentials (never commit keys)
*credentials*.json
*service-account*.json
*-key.json
*.pem
*.key

# Python byte-compiled / packaging / caches
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
.venv*
venv/
env/
ENV/

# Testing, linting & type-checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Google ADK & Gemini local state
.adk/
.gemini/

# MCP Toolbox local binary & Node artifacts
/toolbox
/mcp_toolbox/toolbox
*.exe
node_modules/
npm-debug.log*

# Terraform (if IaC is added)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Logs, OS & editors
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
