# ============================================================================
# Environment Configuration for DevFest Montréal ADK + AlloyDB MCP Demo
# Copy to `.env` and customize if needed: `cp .env.example .env`
# ============================================================================

# Gemini / Vertex AI configuration for Google ADK
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=devfest-project
GOOGLE_CLOUD_LOCATION=global
ADK_MODEL=gemini-3-flash-preview
# Or if using Gemini Developer API key instead of Vertex AI ADC:
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-api-key

# Switch MCP Architecture: "toolbox" (Option 1: Local/Custom) or "remote" (Option 2: Cloud Remote MCP)
MCP_MODE=remote

# AlloyDB Target Configuration
ALLOYDB_PROJECT_ID=devfest-project
ALLOYDB_REGION=us-west1
ALLOYDB_CLUSTER=devfest-cluster
ALLOYDB_INSTANCE=devfest-cluster-pr
ALLOYDB_DATABASE=support_db
ALLOYDB_IP_TYPE=public
ALLOYDB_IAM_USER=postgres

# Option 1: MCP Toolbox settings (npx -y @toolbox-sdk/server --config mcp_toolbox/tools.yaml)
TOOLBOX_URL=http://127.0.0.1:5000
TOOLBOX_TOOLSET=support_triage_toolset

# Option 2: Google Cloud AlloyDB Remote MCP settings
# Global GA endpoint: https://alloydb.googleapis.com/mcp
# Regional Preview endpoint: https://alloydb.us-west1.rep.googleapis.com/mcp
ALLOYDB_MCP_URL=https://alloydb.googleapis.com/mcp
MCP_READ_ONLY=false
