# /**
#  * @file .env.example
#  * @description Environment variable template for the Pitch Generator application.
#  *
#  * Why: Documents every configuration knob consumed by pitch_generator/config.py
#  * without committing environment-specific project IDs or credentials.
#  */
PROJECT_ID=your-gcp-project-id
REGION=us-central1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
LOGS_BUCKET_NAME=your-gcp-project-id-bwg
MEMORY_BANK_ID=pitch-generator-memory
VISUAL_DIRECTOR_URL=http://localhost:8801
PITCH_GENERATOR_URL=http://localhost:8080
FLASH_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-nano-banana-2.1
LOCAL_MODEL=gemma-3-4b-it
