# Cloud Deployment Configuration Template
# Copy this file to deploy.env and set your target environment values.
# DO NOT commit deploy.env to version control.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
BRIDGE_DEFAULT_TENANT=
GCS_DATA_BUCKET=your-gcp-project-id-bridge-deck-data
# Phase 3. Optional cold disaster recovery mirror (M1–M3). Leave blank if not configured.
BACKUP_REPO_URL=
