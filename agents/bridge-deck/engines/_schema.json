{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BridgeDeckEngines",
  "type": "object",
  "required": ["engines"],
  "properties": {
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "type", "models", "provider_types"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the engine / core runtime."
          },
          "name": {
            "type": "string",
            "description": "Human-readable display name of the core."
          },
          "category": {
            "type": "string",
            "enum": ["model", "agent", "contributor"],
            "description": "Classification category for the core runtime."
          },
          "type": {
            "type": "string",
            "description": "Adapter runtime type string."
          },
          "icon": {
            "type": "string",
            "description": "Emoji icon representing the core runtime."
          },
          "location": {
            "type": "string",
            "description": "Default execution region or location endpoint."
          },
          "description": {
            "type": "string",
            "description": "Detailed description of the runtime and capabilities."
          },
          "provider_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "description": "List of router provider type strings that map to this core."
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {"type": "string"},
                "name": {"type": "string"},
                "model_id": {"type": "string"},
                "location": {"type": "string"},
                "provider": {"type": "string"},
                "category": {"type": "string"},
                "description": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
