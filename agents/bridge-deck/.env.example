# ==============================================================================
# Project Bridge Deck — Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform & Vertex AI Configuration
# ------------------------------------------------------------------------------
# Standard Google Cloud Project ID used by GCPModelClient & Vertex AI Providers
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Legacy fallback project variable (supported across all providers)
GCP_PROJECT=your-gcp-project-id

# Default Region / Location for Vertex AI API Calls (e.g. us-central1 or global)
GOOGLE_CLOUD_LOCATION=us-central1
# Legacy fallback location variable
GCP_LOCATION=us-central1

# ------------------------------------------------------------------------------
# Server Network & Security Configuration
# ------------------------------------------------------------------------------
# Required when binding to non-loopback interfaces (e.g. 0.0.0.0 or LAN IP).
# If unbound on localhost/127.0.0.1, auth token is optional for local development.
BRIDGE_AUTH_TOKEN=your-secure-bearer-token-here

# Server host interface and port configuration
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8080
