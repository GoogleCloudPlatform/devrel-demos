"""Unified CLI (`tools/news-lab`) for the Breaking News Lab agent harness.

Subcommands:
  grade <draft.md>   Run Truth, Safety, and Reading referees on a draft
  dream [--dry-run]  Consolidate verified scratchpad facts into memory_graph.json
  memory             Print the current memory graph summary
"""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

ROOT_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT_DIR / "grades"))
sys.path.insert(0, str(ROOT_DIR / "memory"))

from dream import DEFAULT_GRAPH_PATH, dream  # noqa: E402
from run_all_grades import grade_draft, print_scoreboard  # noqa: E402


def show_memory(graph_path: Path = DEFAULT_GRAPH_PATH) -> int:
    data = json.loads(graph_path.read_text(encoding="utf-8"))
    print(f"=== Breaking News Lab Memory Graph ({graph_path.name}) ===")
    print(f"  Last Dream:       {data.get('last_dream_at', 'never')}")
    print(f"  Verified Sources: {', '.join(data.get('verified_sources', []))}")
    print(f"  Rumor Mills:      {', '.join(data.get('known_rumor_mills', []))}")
    print(f"  Permanent Nodes:  {len(data.get('nodes', []))}")
    for n in data.get("nodes", []):
        print(f"    - [{n['id']}] {n['entity']}: {n['claim']} (Source: {n['source']})")
    print(f"  Pending Scratchpad Notes: {len(data.get('scratchpad', []))}")
    for s in data.get("scratchpad", []):
        tag = "verified" if s.get("verified") else "UNVERIFIED"
        print(f"    * [{tag}] {s.get('entity')}: {s.get('claim')} (Source: {s.get('source')})")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="news-lab", description="Breaking News Lab Agent Harness CLI")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_grade = sub.add_parser("grade", help="Run Truth, Safety, and Reading grades on a draft")
    p_grade.add_argument("draft", type=Path, help="Path to markdown draft")
    p_grade.add_argument("--json", action="store_true", help="Output JSON")

    p_dream = sub.add_parser("dream", help="Consolidate memory scratchpad and prune rumors")
    p_dream.add_argument("--dry-run", action="store_true", help="Preview without modifying memory_graph.json")

    sub.add_parser("memory", help="Inspect current memory graph and scratchpad")

    args = parser.parse_args()
    if args.cmd == "grade":
        report = grade_draft(args.draft)
        if args.json:
            print(json.dumps(report, indent=2))
        else:
            print_scoreboard(report)
        return 0 if report["overall_passed"] else 1
    elif args.cmd == "dream":
        summary = dream(dry_run=args.dry_run)
        print(
            f"Breaking News Lab Dreaming [COMPLETE] — "
            f"Promoted: {summary['promoted_count']} | Pruned Rumors: {summary['pruned_count']} | "
            f"Graph Size: {summary['total_nodes']} nodes, {summary['total_edges']} edges"
        )
        return 0
    elif args.cmd == "memory":
        return show_memory()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
