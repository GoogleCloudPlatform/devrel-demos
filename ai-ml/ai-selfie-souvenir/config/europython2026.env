# Application Metadata & UI Headers
EVENT_TITLE="EuroPython 2026"
APP_NAME="Kraków Souvenir"
APP_SUBTITLE="Generate your Wawel Dragon selfie"
FOOTER_CREDIT="Web App Generated using Google Antigravity (<a href='https://antigravity.google' target='_blank'>antigravity.google</a>)"

# Google GenAI SDK Configuration (for Nano Banana requests)
GOOGLE_GENAI_USE_ENTERPRISE="True"
GOOGLE_CLOUD_LOCATION="global"
# To authenticate locally, configure the Application Default Credentials by running:
#   gcloud auth application-default set-quota-project YOUR_PROJECT_ID
#   gcloud auth application-default login
# On Cloud Run, the host project ID will automatically be used.

# Deployment to Cloud Run
CLOUD_RUN_REGION="europe-central2"
SHOW_CLOUD_RUN_REGION="1"

# Base Reference Image & Attribution
BASE_IMAGE_URI="gs://lpdemo-misc-pics/krakow_dragon.jpg"
BASE_IMAGE_LABEL="Wawel Dragon Statue"
BASE_IMAGE_ATTRIBUTION="Photo by Wojciech Wyszkowski"
BASE_IMAGE_ATTRIBUTION_URL="https://unsplash.com/photos/bronze-dragon-statue-on-rock-brick-buildings-and-trees-Fv8cCi9Vbe4"

# Nano Banana Model
NANO_BANANA_MODEL_ID="gemini-3.1-flash-image"

# Prompt Template
PROMPT_TEMPLATE="
## Inputs

- First Image (IMAGE_1): Wawel Dragon statue reference image (its mouth is oriented toward the top).
- Second Image (IMAGE_2): Selfie of one or several persons.

## Output

- Style: Live-action photorealistic cinematic movie still.
- Orientation: Vertical (portrait).
- Background: The Wawel Dragon statue from IMAGE_1, set in a dramatic medieval Kraków atmosphere, with bright glowing fire shooting realistically upward directly out from its open mouth, aligned with the head's upward orientation.
- Foreground: A medium close-up portrait shot of the person(s) from IMAGE_2, dressed in detailed medieval outfits, placed in front of the dragon.
- Blending: Match the lighting, shadows, and color tones of the foreground person(s) with the fire-lit atmosphere of the background for a seamless composition.
- Constraints:
  - The final image must contain ONLY the Wawel Dragon and the exact person(s) from IMAGE_2.
  - Absolutely no other people, background characters, extras, bystanders, crowds, knights, or soldiers should be added anywhere in the scene.
  - Keep the exact same person(s) (preserve their facial features and identities).
  - Remove all modern items and anachronisms (e.g., glasses, wristwatches, smartphones).
"

# Branding & Theme Colors (Hex values)
PRIMARY_COLOR="#d97706"
ACCENT_COLOR="#f59e0b"

# Security, Privacy & Rate Limiting
PRIVACY_NOTICE="🔒 Camera feed is local and data is not stored. You are the sole owner of the provided inputs and generated outputs."
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW="60"
